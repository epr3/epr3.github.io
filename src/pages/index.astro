---
import Company from "../components/Company.astro";

import Layout from "../layouts/Layout.astro";

import { getCollection } from "astro:content";

const companiesEntries = await getCollection("experience");

const companiesWithProjects = companiesEntries.map((item) => ({
  name: item.data.companyName,
  order: item.data.order,
  id: item.id,
}));

companiesWithProjects.sort((a, b) => (a.order > b.order ? -1 : 1));
---

<Layout title="Eduard Predescu">
  <main class="flex-grow z-10 pt-16 pb-24 relative">
    <div class="max-w-[800px] mx-auto px-6 flex flex-col gap-24">
      <section>
        <div class="max-w-3xl">
          <h1 class="text-3xl md:text-5xl font-bold text-on-surface mb-4 leading-tight">
            Eduard Predescu
          </h1>
          <p class="text-xl text-on-surface mb-8">Senior Frontend Engineer.</p>
          <p class="text-base text-on-surface opacity-80 max-w-2xl mb-8">
            Frontend engineer based in Bucharest, RO, with 7+ years of
            experience building web apps with Vue, Nuxt, React, and Next.js.
          </p>
          <div class="flex gap-6">
            <a
              class="text-primary-fixed-dim hover:underline"
              href="https://github.com/epr3/"
              target="_blank"
              data-umami-event="Clicked Github"
            >
              GitHub
            </a>
            <a
              class="text-primary-fixed-dim hover:underline"
              href="https://www.linkedin.com/in/eduardpredescu/"
              target="_blank"
              data-umami-event="Clicked LinkedIn"
            >
              LinkedIn
            </a>
            <a
              class="text-primary-fixed-dim hover:underline"
              href="mailto:eduard.florin.predescu@gmail.com"
              target="_blank"
              data-umami-event="Clicked send email"
            >
              Email
            </a>
            <a
              class="text-primary-fixed-dim hover:underline"
              href="https://bsky.app/profile/epredescu.bsky.social"
              target="_blank"
              data-umami-event="Clicked BlueSky"
            >
              Bluesky
            </a>
            <a
              class="text-primary-fixed-dim hover:underline"
              href="/Eduard_Predescu_Resume.pdf"
              target="_blank"
              data-umami-event="Dowloaded resume"
            >
              Resume
            </a>
          </div>
        </div>
      </section>

      <section>
        <div class="flex flex-col">
          <h2 class="text-xl font-bold text-on-surface mb-8">Experience</h2>
          <div class="flex flex-col gap-12">
            {
              companiesWithProjects.map((item) => (
                <Company name={item.name} id={item.id} />
              ))
            }
          </div>
        </div>
      </section>
    </div>
  </main>

  <footer class="font-body-md text-sm w-full py-12">
    <div class="max-w-[800px] mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-4 text-on-surface opacity-60">
      <div>© {new Date().getFullYear()} Eduard Predescu.</div>
      <nav class="flex gap-6">
        <a
          class="hover:text-primary-fixed-dim transition-colors"
          href="mailto:eduard.florin.predescu@gmail.com"
          target="_blank"
          data-umami-event="Clicked send email"
        >
          Email
        </a>
        <a
          class="hover:text-primary-fixed-dim transition-colors"
          href="https://www.linkedin.com/in/eduardpredescu/"
          target="_blank"
          data-umami-event="Clicked LinkedIn"
        >
          LinkedIn
        </a>
        <a
          class="hover:text-primary-fixed-dim transition-colors"
          href="https://bsky.app/profile/epredescu.bsky.social"
          target="_blank"
          data-umami-event="Clicked BlueSky"
        >
          Bluesky
        </a>
        <a
          class="hover:text-primary-fixed-dim transition-colors"
          href="https://github.com/epr3/"
          target="_blank"
          data-umami-event="Clicked Github"
        >
          GitHub
        </a>
      </nav>
    </div>
  </footer>
</Layout>