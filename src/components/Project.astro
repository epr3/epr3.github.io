---
import type { ProjectedProject } from "../lib/projection";
import { parseProjectBody } from "../lib/project-content";

export interface Props {
  project: ProjectedProject;
}

const { project } = Astro.props;

const body = project.entry.body ?? "";
const result = parseProjectBody(body, `${project.id}.md`);

if (!result.ok) {
  const { source, errors } = result.diagnostics;
  throw new Error(
    `Project "${source}" has invalid content:\n${errors.map((e) => `  - ${e}`).join("\n")}`
  );
}

const { title, link, description, responsibilities } = result.content;
---

<div>
  <p class="text-on-surface-variant font-medium mb-1">{title}</p>
  <p class="flex flex-col gap-1 text-label-sm font-label-sm text-on-surface-variant mt-2 mb-4">
    <span class="inline-flex flex-wrap items-center gap-x-1"><span>Tech stack:</span>{project.stack.map((s) => <span class="whitespace-nowrap">[ {s.name} ]</span>)}</span>
    {
      link && (
        <span>
          Link: <a class="text-primary-fixed-dim hover:text-primary hover:underline focus-visible:outline-2 focus-visible:outline-solid focus-visible:outline-primary transition-colors" href={link} target="_blank">{link}</a>
        </span>
      )
    }
  </p>
  {
    description && (
      <p class="text-on-surface opacity-80 mb-3">{description}</p>
    )
  }
  {
    responsibilities.map((section) => (
      <div class="mb-3">
        <p class="text-on-surface-variant font-medium text-sm mb-1">{section.heading}</p>
        <ul class="list-disc pl-5 text-on-surface opacity-80 space-y-1">
          {section.bullets.map((bullet) => <li>{bullet}</li>)}
        </ul>
      </div>
    ))
  }
</div>
