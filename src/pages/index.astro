---
import Company from "../components/Company.astro";

import Layout from "../layouts/Layout.astro";

import { EMAIL_CONTACT_EVENT } from "../lib/contact-action";
import { loadExperience } from "../lib/experience-loader";

const experience = await loadExperience();
---

<Layout title="Eduard Predescu">
  <main class="flex-grow z-10 pt-16 pb-24 relative">
    <div class="max-w-[800px] mx-auto px-6 flex flex-col gap-24">
      <section>
        <div class="max-w-3xl">
          <span class="block text-primary text-xs font-bold tracking-widest uppercase mb-4">[ 00 ] PROFILE</span>
          <h1 class="text-3xl md:text-5xl font-bold text-on-surface mb-4 leading-tight">
            Eduard Predescu
          </h1>
          <p class="text-xl text-on-surface mb-8">Senior Frontend Engineer.</p>
          <p class="text-base text-on-surface opacity-80 max-w-2xl mb-8">
            Frontend engineer based in Bucharest, RO, with 9+ years of
            experience building web apps with Vue, Nuxt, React, and Next.js.
          </p>
          <div class="flex flex-wrap gap-6">
            <a
              class="text-primary-fixed-dim hover:text-primary hover:underline focus-visible:outline-2 focus-visible:outline-solid focus-visible:outline-primary"
              href="https://github.com/epr3/"
              target="_blank"
              data-umami-event="Clicked Github"
            >
              GitHub
            </a>
            <a
              class="text-primary-fixed-dim hover:text-primary hover:underline focus-visible:outline-2 focus-visible:outline-solid focus-visible:outline-primary"
              href="https://www.linkedin.com/in/eduardpredescu/"
              target="_blank"
              data-umami-event="Clicked LinkedIn"
            >
              LinkedIn
            </a>
            <button
              type="button"
              class="text-primary-fixed-dim hover:text-primary hover:underline focus-visible:outline-2 focus-visible:outline-solid focus-visible:outline-primary"
              data-email-contact
              data-umami-event={EMAIL_CONTACT_EVENT}
            >
              Email
            </button>
            <a
              class="text-primary-fixed-dim hover:text-primary hover:underline focus-visible:outline-2 focus-visible:outline-solid focus-visible:outline-primary"
              href="https://bsky.app/profile/epredescu.bsky.social"
              target="_blank"
              data-umami-event="Clicked BlueSky"
            >
              Bluesky
            </a>
            <a
              class="text-primary-fixed-dim hover:text-primary hover:underline focus-visible:outline-2 focus-visible:outline-solid focus-visible:outline-primary"
              href="/Eduard_Predescu_Resume.pdf"
              target="_blank"
              data-umami-event="Dowloaded resume"
            >
              Resume
            </a>
          </div>
        </div>
      </section>

      <section>
        <div class="flex flex-col">
          <h2 class="text-xl font-bold text-on-surface mb-8"><span class="text-primary">[ 01 ] EXPERIENCE</span></h2>
          <div class="flex flex-col gap-12">
            {
              experience.companies.map((company) => (
                <Company company={company} />
              ))
            }
          </div>
        </div>
      </section>
    </div>
  </main>

  <footer class="font-body-md text-sm w-full py-12">
    <div class="max-w-[800px] mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-4 text-on-surface opacity-60">
      <div>© {new Date().getFullYear()} Eduard Predescu.</div>
      <nav class="flex gap-6">
        <button
          type="button"
          class="hover:text-primary focus-visible:outline-2 focus-visible:outline-solid focus-visible:outline-primary transition-colors"
          data-email-contact
          data-umami-event={EMAIL_CONTACT_EVENT}
        >
          Email
        </button>
        <a
          class="hover:text-primary focus-visible:outline-2 focus-visible:outline-solid focus-visible:outline-primary transition-colors"
          href="https://www.linkedin.com/in/eduardpredescu/"
          target="_blank"
          data-umami-event="Clicked LinkedIn"
        >
          LinkedIn
        </a>
        <a
          class="hover:text-primary focus-visible:outline-2 focus-visible:outline-solid focus-visible:outline-primary transition-colors"
          href="https://bsky.app/profile/epredescu.bsky.social"
          target="_blank"
          data-umami-event="Clicked BlueSky"
        >
          Bluesky
        </a>
        <a
          class="hover:text-primary focus-visible:outline-2 focus-visible:outline-solid focus-visible:outline-primary transition-colors"
          href="https://github.com/epr3/"
          target="_blank"
          data-umami-event="Clicked Github"
        >
          GitHub
        </a>
      </nav>
    </div>
  </footer>
  <script>
    import { initContactActions } from "../lib/contact-action";

    initContactActions();
  </script>
</Layout>
