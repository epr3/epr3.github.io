{
  "name": "personal-cv",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint --fix",
    "format": "prettier --write .",
    "lint:fix": "eslint",
    "lint:format": "pnpm lint:fix && pnpm format",
    "test": "vitest run",
    "test:content": "vitest run src/lib/project-content.test.ts",
    "prepare": "pnpm simple-git-hooks"
  },
  "dependencies": {
    "astro": "7.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^24.13.3",
    "@typescript-eslint/parser": "^8.70.0",
    "@unocss/astro": "66.7.5",
    "@unocss/preset-web-fonts": "^66.7.5",
    "@unocss/reset": "^66.7.5",
    "@unocss/transformer-variant-group": "^66.7.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.14.0",
    "typescript": "6.0.3",
    "unocss": "^66.7.5",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "pnpm commitlint --edit ${1}"
  },
  "lint-staged": {
    "*": "pnpm lint:format"
  }
}
