---
import { formatMonthYear } from "../lib/projection";
import type { ProjectedCompany } from "../lib/projection";
import Project from "./Project.astro";

export interface Props {
  company: ProjectedCompany;
}

const { company } = Astro.props;
---

<div>
  {
    company.roles.map((role) => (
      <p class="text-on-surface font-bold mb-2">
        {company.name} | {role.title} | {formatMonthYear(role.startDate)} -{" "}
        {role.endDate ? formatMonthYear(role.endDate) : "Present"}
      </p>
    ))
  }
  {
    company.projects.length > 0 && (
      <div class="flex flex-col gap-4 pl-5">
        {company.projects.map((project) => <Project project={project} />)}
      </div>
    )
  }
</div>
