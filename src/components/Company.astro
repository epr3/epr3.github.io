---
import dayjs from "dayjs";
import { getCollection } from "astro:content";
import Project from "./Project.astro";
export interface Props {
  id: string;
  name: string;
}

const { id, name } = Astro.props;

const titles = await getCollection(
  "titles",
  (entry) => entry.data.company.id === id
);

titles.sort((a, b) => (a.data.startDate > b.data.startDate ? -1 : 1));

const projects = await getCollection(
  "projects",
  (entry) => entry.data.company.id === id
);

projects.sort((a, b) => (a.data.order > b.data.order ? -1 : 1));

const fmt = (date: string) => dayjs(date).format("MMM YYYY");
---

<div>
  {
    titles.map((title) => (
      <p class="text-on-surface font-bold mb-2">
        {name} | {title.data.title} | {fmt(title.data.startDate)} -{" "}
        {title.data.endDate ? fmt(title.data.endDate) : "Present"}
      </p>
    ))
  }
  {
    projects.length > 0 && (
      <div class="flex flex-col gap-4 pl-5">
        {projects.map((project) => <Project project={project} />)}
      </div>
    )
  }
</div>
